---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Announcement from '../components/Announcement.astro';
import { page, PAGES, cardUrl, NAME, ANNOUNCEMENT, CF_BEACON } from '../lib/site.mjs';
import { BLOG } from '../lib/blog.mjs';
// Each page's description and social card come from src/lib/site.mjs, the same words llms.txt uses.
const here = page(Astro.url.pathname);
const { title, noindex = false, jsonld = [], type = 'website' } = Astro.props;
const description = Astro.props.description || here?.description || PAGES[0].description;
const card = Astro.props.card || here?.card || 'home';
const fullTitle = title ? `${title} · ${NAME}` : 'Napwake: non-prod environments that sleep when nobody’s using them';
// a noindex page, such as the 404, has no address of its own to name
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = cardUrl(card);
// The icons: browsers that read SVG take the brand's favicon.svg, which follows the theme, and the rest
// favicon.ico. Its sizes="32x32" keeps Chrome on the SVG. The PNGs and the ICO come from scripts/icons.mjs.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The content security policy, filled in once the build is done (astro.config.mjs). Before any script. */}
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content="__NAPWAKE_CSP__" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BigShouldersDisplay-800.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={NAME} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title || NAME}: ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {BLOG && <link rel="alternate" type="application/rss+xml" title="Napwake blog" href="/blog/rss.xml" />}
    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
    <script is:inline>
      // Before paint: a stored choice, or ?theme= for checking a page in one theme.
      (function () {
        var t = null;
        try { t = new URLSearchParams(location.search).get('theme') || localStorage.getItem('napwake-theme'); } catch (e) {}
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <script is:inline define:vars={{ id: ANNOUNCEMENT.id }}>
      // a dismissed announcement stays hidden, without a flash
      try { if (localStorage.getItem('napwake-announce-dismissed') === id) document.documentElement.setAttribute('data-announce-off', ''); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <Announcement />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {CF_BEACON && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON })}></script>}
  </body>
</html>
