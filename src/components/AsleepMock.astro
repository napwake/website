---
// The asleep page as a browser shows it: what a paused workload set to ask first shows a browser.
// From the asleep page's template, in WakingMock's frame and scale.
// Its scene uses the waking page's geometry (viewBox 0 0 300 236), so the two mocks read as one door.
// Shown as the page looks with the pointer on Wake it: light under the door, and the doorman glances at it.
// It loads nothing, so it's set in the system's fonts, as the real page is.
import { figure } from '../lib/rig/doorman.mjs';
import { DOORMAN, tokenize } from '../lib/art.mjs';
const { address = 'pr-412.preview.example.dev' } = Astro.props;

// The pose "Asks at the door" (doorman-ask.svg), from the asleep page's build: his hand flat on the shut
// leaf, his head cocked. Here his eyes glance at the door, as on the page when Wake it is hovered or focused.
const at = (dx, dy) => ([x, y]) => [x + dx, y + dy];
const ASK = {
  lean: 3, bow: 1, turn: 0.1, headTilt: -10,
  eyes: { lidL: 0.34, lidR: 0.46, tiltL: -8, tiltR: 4, look: [0.85, 0.12] },
  arms: { R: { e: at(13, 22), h: at(35, 10), thumb: -1, kind: 'flat' }, L: { e: at(-4, 30), h: at(1, 56), thumb: 1 } },
};
const LEAF = 'M150 210V82a40 40 0 0 1 80 0v128z';
const scene = tokenize(
  '<path fill="var(--scene-frame-soft)" d="M144 210V82a46 46 0 0 1 92 0v128z"/>' +
  `<path fill="var(--scene-leaf)" d="${LEAF}"/>` +
  '<path stroke="var(--scene-leaf-edge)" stroke-width="1.6" d="M190 82V210"/><circle cx="215" cy="136" r="3" fill="var(--doorman-brass)"/>' +
  '<path fill="var(--lamp)" opacity=".4" d="M150 210h80l22 9H140z"/><path fill="var(--lamp)" d="M151 205.8h78v4.2h-78z"/>' +
  '<path fill="none" stroke="var(--lamp)" stroke-width="2.6" stroke-linecap="round" d="M228.9 209V82a38.9 38.9 0 0 0-11.4-27.5"/>' +
  `<g transform="translate(128.6 210) scale(.86)">${figure({ ...ASK, ground: true }, DOORMAN)}</g>` +
  '<path stroke="var(--line)" stroke-width="2" d="M0 210h300"/>'
);
const ASLEEP = '<path d="M6 22V10a6 6 0 0 1 12 0v12z" fill="var(--glyph-slate)"/><circle cx="15.3" cy="15" r="1.2" fill="var(--paper)"/>';
const MARK = '<path fill="currentColor" d="M7.6 9.9L7.2 3.6Q7.2 2.6 8.2 2.6Q12 2.2 15.8 2.6Q16.8 2.6 16.8 3.6L16.4 9.9ZM3.4 10.7Q3.4 9.8 4.6 9.9H19.4Q20.6 9.8 20.6 10.7Q20.6 11.7 19.4 11.7H4.6Q3.4 11.7 3.4 10.7ZM6.6 19.2V13.8Q6.6 12.5 7.9 12.5H16.1Q17.4 12.5 17.4 13.8V19.2ZM8 15.4A1.9 1.9 0 0 0 11.8 15.4Z M12.2 15.4A1.9 1.9 0 0 0 16 15.4ZM3 24V22.2Q3 20 5.2 20H18.8Q21 20 21 22.2V24Z"/>';
// the pointer, resting on Wake it
const POINTER = '<path d="M1 1v15.5l4.1-3.9 2.7 6.1 2.6-1.1-2.6-6h5.7z" fill="var(--paper)" stroke="var(--night)" stroke-width="1.3" stroke-linejoin="round"/>';
---
<div class="am" role="img" aria-label={`A browser at ${address}, showing the asleep page: Asleep. Wake it up? This environment was paused because it looked unused, to save money. Press Wake it to start it again. This page opens it when it's ready. A Wake it button, with the pointer on it. The doorman asks first. Crawlers, scanners and API calls wake nothing.`}>
  <div class="am__bar" aria-hidden="true"><span class="am__dots"><i></i><i></i><i></i></span><span class="am__url">{address}</span></div>
  <div class="am__page" aria-hidden="true">
    <div class="am__head">{address}</div>
    <div class="am__main">
      <svg class="am__scene" viewBox="0 0 300 236" set:html={scene} />
      <div>
        <div class="am__state"><svg viewBox="0 0 24 24" set:html={ASLEEP} />Asleep</div>
        <p class="am__h1">Wake it up? <span>{address}</span></p>
        <p class="am__lede">This environment was paused because it looked unused, to save money. Press Wake it to start it again. This page opens it when it’s ready.</p>
        <div class="am__ask">
          <span class="am__btn">Wake it<svg class="am__pointer" viewBox="0 0 18 21" set:html={POINTER} /></span>
          <span class="am__takes">Starting takes as long as the app needs.</span>
        </div>
        <p class="am__why"><svg viewBox="0 0 24 24" set:html={MARK} />The doorman asks first. Crawlers, scanners and API calls wake nothing.</p>
      </div>
    </div>
    <div class="am__foot"><span>Kept out of search engines</span><span class="am__by"><svg viewBox="0 0 24 24" set:html={MARK} />Paused by Napwake</span></div>
  </div>
</div>
<style>
  .am { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-window); background: var(--bg); font-family: var(--font-system-sans); }
  .am__bar { display: flex; align-items: center; gap: var(--space-3); padding: 9px 12px; background: var(--surface); border-bottom: 1px solid var(--line); }
  .am__dots { display: inline-flex; gap: 6px; }
  .am__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .am__url { flex: 1; font: 12px/1.6 var(--font-system-mono); color: var(--muted); background: var(--bg); border-radius: var(--radius-sm); padding: 2px 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .am__page { font-size: 13px; }
  .am__head { padding: 12px 18px 0; font: 11px var(--font-system-mono); color: var(--muted); overflow-wrap: anywhere; }
  .am__main { display: grid; grid-template-columns: 38% minmax(0, 1fr); gap: 20px; align-items: center; padding: 6px 18px 4px; }
  .am__scene { width: 100%; height: auto; overflow: visible; }
  .am__state { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; font: 700 10.5px var(--font-system-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--asleep); }
  .am__state svg { width: 14px; height: 14px; }
  .am__h1 { margin: 0 0 8px; font: 800 22px/1.08 var(--font-system-sans); letter-spacing: -.02em; color: var(--text); }
  .am__h1 span { display: block; font: 500 12.5px/1.4 var(--font-system-mono); color: var(--muted); letter-spacing: 0; margin-top: 4px; overflow-wrap: anywhere; }
  .am__lede { margin: 0 0 12px; color: var(--muted); font-size: 12.5px; line-height: 1.55; }
  .am__ask { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin: 0 0 12px; }
  .am__btn { position: relative; flex: none; font: 700 12.5px/1.6 var(--font-system-sans); padding: 5px 22px; min-width: 7.5em; text-align: center; border: 2px solid var(--action); border-radius: var(--radius-sm); background: var(--action); color: var(--on-action); }
  .am__pointer { position: absolute; left: calc(100% - 19px); top: 56%; width: 13px; height: auto; overflow: visible; }
  .am__takes { flex: 1 1 120px; color: var(--muted); font-size: 11px; line-height: 1.45; }
  .am__why { display: flex; align-items: center; gap: 8px; margin: 0; padding-top: 8px; border-top: 1px solid var(--line); font: 10.5px/1.5 var(--font-system-mono); color: var(--muted); }
  .am__why svg, .am__by svg { flex: none; width: 13px; height: 13px; color: var(--doorman-coat); }
  .am__foot { display: flex; justify-content: space-between; gap: 12px; padding: 12px 18px 14px; font: 10.5px var(--font-system-mono); color: var(--muted); }
  .am__by { display: inline-flex; align-items: center; gap: 6px; }
  @media (max-width: 480px) { .am__main { grid-template-columns: minmax(0, 1fr); } .am__scene { max-width: 170px; } .am__btn { flex: 1 1 100%; } }
</style>
