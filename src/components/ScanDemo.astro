---
// "One command, and you get a report you can send your team." A terminal types `kubectl napwake scan` and
// prints the product's own lines for an example cluster; then a browser window opens on the real report
// for the same cluster, live: hover the doors, sort the tables. Both come from the product's code on the
// same made-up data (scripts/render-scan-example.sh), so every number agrees.
// Reduced motion or no script: the final state, still. Phones: the command, then a tap-to-open preview.
import Terminal from './Terminal.astro';
import raw from '../content/examples/scan-first.txt?raw';

const out = raw.split('\n');
const pick = (start) => out.find((l) => l.startsWith(start));
// a few lines of the real output, in order, trimmed: none changed, none invented
const lines = [
  pick('staging (EKS'),
  pick('Node autoscaler:'),
  pick('History:'),
  '',
  pick('  19 workloads are idle right now'),
  pick('  They cost $'),
  pick('  Replaying the last 7 days'),
  pick('  and freed $'),
  '  …',
].filter((l) => l !== undefined);
// the CLI's own line when it opens the report (showPage in report.go); the file name is os.CreateTemp's, so an example
const file = '/tmp/napwake-scan-2803149716.html';
const report = `Report: ${file} (opened in your browser; --open=false to skip)`;
const cluster = out[0].split(':')[0];
---
<div class="demo" data-demo data-state="done">
  <div class="demo__stage" aria-label={`An example: kubectl napwake scan runs in a terminal on an example cluster, ${cluster}, and opens its report in a browser.`} role="group">
    <div class="win win--term">
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__title" aria-hidden="true">kubectl napwake scan</span><button type="button" class="demo__replay" data-replay hidden>Replay</button></div>
      <pre class="term"><code><span class="term__p" aria-hidden="true">$ </span><span class="term__cmd" data-cmd>kubectl napwake scan</span><span class="term__caret" aria-hidden="true"></span>{'\n'}{lines.map((l) => <span class="term__l" data-line>{l || ' '}{'\n'}</span>)}<span class="term__l term__l--report" data-line>{report}</span></code></pre>
    </div>
    <div class="win win--web" data-web>
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__url">file://{file}</span><span class="win__tag">Example cluster</span></div>
      <div class="web" data-view>
        <iframe data-src="/examples/scan-report/" title={`The scan report for an example cluster, ${cluster}: live, scrollable, sortable`} loading="lazy"></iframe>
        <noscript><a class="web__open" href="/examples/scan-report/">Open the example report</a></noscript>
      </div>
    </div>
  </div>

  <div class="demo__phone">
    <Terminal command="kubectl napwake scan" label="The command" />
    <a class="preview" href="/examples/scan-report/" target="_blank" rel="noopener">
      <span class="preview__bar" aria-hidden="true"><span class="win__dots"><i></i><i></i><i></i></span><span class="win__tag">Example cluster</span></span>
      <img class="on-light" src="/examples/scan-report-phone-light.webp" width="390" height="560" alt="" loading="lazy" decoding="async" />
      <img class="on-dark" src="/examples/scan-report-phone-dark.webp" width="390" height="560" alt="" loading="lazy" decoding="async" />
      <span class="preview__go">Open the example report <span aria-hidden="true">↗</span></span>
    </a>
  </div>
</div>

<style>
  .demo__stage { position: relative; height: 640px; }
  .win { position: absolute; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-window); background: var(--surface); }
  .win__bar { display: flex; align-items: center; gap: var(--space-3); height: 36px; padding: 0 12px; border-bottom: 1px solid var(--line); background: var(--surface); }
  .win__dots { display: inline-flex; gap: 6px; flex: none; }
  .win__dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .win__title { font: 400 12px/1 var(--font-mono); color: var(--muted); }
  .win__url { flex: 1; min-width: 0; font: 400 12px/1.6 var(--font-mono); color: var(--muted); background: var(--bg); border-radius: var(--radius-sm); padding: 2px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .win__tag { flex: none; font: 700 11px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); border: 1px solid currentColor; border-radius: var(--radius-sm); padding: 4px 6px; }

  .win--term { left: 0; top: 56px; width: 41%; height: 548px; z-index: 1; background: var(--code-bg); }
  .term { margin: 0; height: calc(100% - 36px); padding: var(--space-4) 52px var(--space-4) 18px; font: 400 12.5px/1.6 var(--font-mono); color: var(--code-text); background: var(--code-bg); white-space: pre-wrap; overflow: hidden; }
  .term code { font: inherit; background: none; padding: 0; white-space: inherit; }
  .term__p { color: var(--muted); user-select: none; }
  .term__l--report { color: var(--accent-text); font-weight: 700; }
  .term__caret { display: none; width: .6em; height: 1.1em; vertical-align: -.2em; background: var(--code-text); margin-left: 1px; }
  .demo__replay { margin-left: var(--space-2); font: 700 11px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 6px 8px; cursor: pointer; }
  .demo__replay:hover { color: var(--text); border-color: var(--muted); }

  .win--web { right: 0; top: 0; width: 62%; height: 640px; z-index: 2; transition: opacity var(--duration-ui-long) var(--ease-calm), transform var(--duration-ui-long) var(--ease-calm); }
  .web { position: relative; height: calc(100% - 36px); overflow: hidden; background: var(--bg); --s: 1; }
  .web iframe { display: block; border: 0; width: calc(100% / var(--s)); height: calc(100% / var(--s)); transform: scale(var(--s)); transform-origin: 0 0; background: var(--bg); color-scheme: inherit; }
  .web__open { position: absolute; inset: 0; display: grid; place-items: center; font-weight: 700; }

  /* the run: lines and the browser appear as the script reaches them */
  .demo[data-state="run"] [data-line]:not(.on), .demo[data-state="idle"] [data-line] { visibility: hidden; }
  .demo[data-state="idle"] .term__cmd, .demo[data-state="run"] .term__cmd:not(.on) { display: none; }
  .demo[data-state="run"] .term__caret, .demo[data-state="idle"] .term__caret { display: inline-block; animation: caret 1s steps(1) infinite; }
  .demo[data-state="idle"] .win--web, .demo[data-state="run"]:not(.is-open) .win--web { opacity: 0; transform: translateY(16px) scale(.985); pointer-events: none; }
  @keyframes caret { 50% { opacity: 0; } }

  .demo__phone { display: none; }
  .preview { display: block; margin-top: var(--space-4); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; color: var(--text); text-decoration: none; background: var(--surface); box-shadow: var(--shadow-window); }
  .preview__bar { display: flex; justify-content: space-between; align-items: center; height: 32px; padding: 0 12px; border-bottom: 1px solid var(--line); }
  .preview img { width: 100%; height: auto; aspect-ratio: 390 / 560; object-fit: cover; object-position: top; }
  .preview__go { display: flex; justify-content: center; padding: 12px; font-weight: 700; border-top: 1px solid var(--line); color: var(--link); }

  @media (max-width: 1099px) {
    .demo__stage { height: auto; display: grid; gap: 0; }
    .win { position: relative; inset: auto; width: auto; }
    .win--term { height: auto; top: auto; margin-right: 12%; }
    .term { height: auto; padding-right: 18px; padding-bottom: 44px; }
    .win--web { height: 600px; margin: -24px 0 0 8%; }
  }
  @media (max-width: 760px) {
    .demo__stage { display: none; }
    .demo__phone { display: block; }
  }
</style>

<script>
  const TYPE_MS = 48, LINE_MS = 70;
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const wide = matchMedia('(min-width: 761px)');
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const cmd = demo.querySelector<HTMLElement>('[data-cmd]')!;
    const text = cmd.textContent || '';
    const lines = [...demo.querySelectorAll<HTMLElement>('[data-line]')];
    const replay = demo.querySelector<HTMLButtonElement>('[data-replay]')!;
    const view = demo.querySelector<HTMLElement>('[data-view]')!;
    const frame = view.querySelector('iframe')!;
    let run = 0;

    // the report is laid out as on a laptop, 1000 px wide, and scaled to fit the window
    const fit = () => view.style.setProperty('--s', String(Math.min(1, view.clientWidth / 1000)));
    new ResizeObserver(fit).observe(view);
    const load = () => { if (!frame.src) frame.src = frame.dataset.src || ''; };

    const finish = () => { demo.dataset.state = 'done'; demo.classList.add('is-open'); cmd.textContent = text; cmd.classList.add('on'); lines.forEach((l) => l.classList.add('on')); };
    const play = async () => {
      const me = ++run;
      replay.hidden = true;
      demo.classList.remove('is-open'); lines.forEach((l) => l.classList.remove('on'));
      demo.dataset.state = 'run'; cmd.textContent = ''; cmd.classList.add('on');
      await sleep(500);
      for (const ch of text) { if (me !== run) return; cmd.textContent += ch; await sleep(TYPE_MS); }
      await sleep(380);
      for (const l of lines) { if (me !== run) return; l.classList.add('on'); await sleep(l.classList.contains('term__l--report') ? 0 : LINE_MS); }
      await sleep(650);
      if (me !== run) return;
      demo.classList.add('is-open');
      await sleep(600);
      demo.dataset.state = 'done';
      replay.hidden = false;
    };

    if (!wide.matches) continue; // phones get the command and the preview; the iframe never loads there
    if (still.matches) { finish(); }
    else { demo.dataset.state = 'idle'; }
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        load();
        if (!still.matches && demo.dataset.state === 'idle') play();
        seen.disconnect();
      }
    }, { threshold: 0.3 });
    seen.observe(demo);
    // start loading the report a little before it's reached
    const near = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { load(); near.disconnect(); } }, { rootMargin: '600px 0px' });
    near.observe(demo);
    replay.addEventListener('click', play);
    still.addEventListener('change', () => { if (still.matches) { run++; finish(); replay.hidden = true; } });
  }
</script>
