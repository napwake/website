---
// The waking page as a browser shows it, from the design system's WakingPage (internal/doorman/page.html).
// It loads nothing, so it's set in the system's fonts, as the real page is.
import { figure, POSES } from '../lib/rig/doorman.mjs';
import { doorHand } from '../lib/rig/scene.mjs';
import { DOORMAN, tokenize } from '../lib/art.mjs';
const { address = 'staging.example.com', elapsed = '0:14' } = Astro.props;
const k = 0.86, hx = doorHand()[0];
const fig = figure({ ...POSES.door, ground: false }, DOORMAN);
const scene = tokenize(
  '<path fill="var(--scene-frame-soft)" d="M144 210V82a46 46 0 0 1 92 0v128z"/>' +
  '<path fill="var(--scene-room-amber)" d="M150 210V82a40 40 0 0 1 80 0v128z"/>' +
  '<path class="wm__wedge" fill="var(--scene-wedge)" d="M190 210h40l70 26H214z"/>' +
  '<path fill="var(--scene-leaf)" d="M150 210V82a40 40 0 0 1 24-36.7l16 6.7v158z"/><circle cx="182" cy="140" r="3" fill="var(--doorman-brass)"/>' +
  `<path fill="var(--night)" style="opacity:.12" d="M${(190 - hx * k - 26).toFixed(1)} 210h56l-70 22h-70z"/>` +
  `<g transform="translate(${(190 - hx * k).toFixed(1)} 210) scale(${k})">${fig}</g>` +
  '<path stroke="var(--line)" stroke-width="2" d="M0 210h300"/>'
);
const DONE = '<path d="M5 25V11a7 7 0 0 1 14 0v14z" fill="var(--doorman-coat)"/><path fill="none" stroke="var(--paper)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M8.5 15.2 11 17.5l4.5-5"/>';
const NOW = '<path d="M5 25V11a7 7 0 0 1 14 0v14z" fill="var(--scene-room-amber)" stroke="var(--waking)" stroke-width="1.6"/><path d="M5 25V11a7 7 0 0 1 4-6.3L12 6.5V25z" fill="var(--scene-leaf)"/>';
const NEXT = '<path d="M5 25V11a7 7 0 0 1 14 0v14z" fill="none" stroke="var(--line)" stroke-width="1.6"/>';
const STATE = '<path d="M6 22V10a6 6 0 0 1 12 0v12z" fill="var(--scene-room-amber)" stroke="currentColor" stroke-width="1.6"/><path d="M6 22V10a6 6 0 0 1 3.5-5.4L12 6v16z" fill="var(--scene-leaf)"/>';
---
<div class="wm" role="img" aria-label={`A browser at ${address}, showing the waking page: Waking up. This environment was paused while nobody was using it. It's starting now, and this page opens it on its own when it's ready. Request received; starting, ${elapsed} so far; ready next.`}>
  <div class="wm__bar" aria-hidden="true"><span class="wm__dots"><i></i><i></i><i></i></span><span class="wm__url">{address}</span></div>
  <div class="wm__page" aria-hidden="true">
    <div class="wm__head">{address}</div>
    <div class="wm__main">
      <svg class="wm__scene" viewBox="0 0 300 236" set:html={scene} />
      <div>
        <div class="wm__state"><svg viewBox="0 0 24 24" set:html={STATE} />Waking</div>
        <p class="wm__h1">Waking up <span>{address}</span></p>
        <p class="wm__lede">This environment was paused while nobody was using it. It’s starting now, and this page opens it on its own when it’s ready.</p>
        <ol>
          <li class="done"><svg viewBox="0 0 24 26" set:html={DONE} />Request received</li>
          <li class="now"><svg viewBox="0 0 24 26" set:html={NOW} />Starting<span class="t">{elapsed}</span></li>
          <li><svg viewBox="0 0 24 26" set:html={NEXT} />Ready</li>
        </ol>
      </div>
    </div>
    <div class="wm__foot"><span>Refreshes automatically</span><span>Paused by Napwake</span></div>
  </div>
</div>
<style>
  .wm { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-window); background: var(--bg); font-family: var(--font-system-sans); }
  .wm__bar { display: flex; align-items: center; gap: var(--space-3); padding: 9px 12px; background: var(--surface); border-bottom: 1px solid var(--line); }
  .wm__dots { display: inline-flex; gap: 6px; }
  .wm__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .wm__url { flex: 1; font: 12px/1.6 var(--font-system-mono); color: var(--muted); background: var(--bg); border-radius: var(--radius-sm); padding: 2px 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wm__page { font-size: 13px; }
  .wm__head { padding: 12px 18px 0; font: 11px var(--font-system-mono); color: var(--muted); }
  .wm__main { display: grid; grid-template-columns: 38% minmax(0, 1fr); gap: 20px; align-items: center; padding: 6px 18px 4px; }
  .wm__scene { width: 100%; height: auto; }
  .wm__wedge { opacity: var(--light-wedge); transform-box: fill-box; transform-origin: 0 0; animation: wm-breathe var(--duration-breathe) var(--ease-breathe) infinite; }
  @keyframes wm-breathe { 50% { opacity: .3; transform: scaleX(.88); } }
  .wm__state { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; font: 700 10.5px var(--font-system-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--waking); }
  .wm__state svg { width: 14px; height: 14px; }
  .wm__h1 { margin: 0 0 8px; font: 800 22px/1.08 var(--font-system-sans); letter-spacing: -.02em; color: var(--text); }
  .wm__h1 span { display: block; font: 500 12.5px/1.4 var(--font-system-mono); color: var(--muted); letter-spacing: 0; margin-top: 4px; }
  .wm__lede { margin: 0 0 12px; color: var(--muted); font-size: 12.5px; line-height: 1.55; }
  .wm ol { list-style: none; margin: 0; padding: 0; font: 11.5px var(--font-system-mono); }
  .wm li { display: flex; align-items: center; gap: 10px; padding: 6px 0; color: var(--muted); border-top: 1px solid var(--line); }
  .wm li.done, .wm li.now { color: var(--text); }
  .wm li svg { width: 14px; height: 15px; flex: none; }
  .wm li .t { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; }
  .wm__foot { display: flex; justify-content: space-between; padding: 12px 18px 14px; font: 10.5px var(--font-system-mono); color: var(--muted); }
  @media (max-width: 480px) { .wm__main { grid-template-columns: minmax(0, 1fr); } .wm__scene { max-width: 170px; } }
</style>
