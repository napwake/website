---
// The door glyph for a state, drawn from the rig's glyph() with glyph-* tokens, so it follows the theme.
import { glyphMarkup } from '../lib/art.mjs';
const { state = 'asleep', size = 24, label, class: cls = '' } = Astro.props;
---
<svg class:list={['nw-door', cls]} viewBox="0 0 24 24" width={size} height={size} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" set:html={glyphMarkup(state)} />
