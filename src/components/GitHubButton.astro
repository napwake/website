---
// The repository on GitHub with its star count: read at build time (src/lib/github.mjs), then refreshed
// in the browser from GitHub's public API, at most every 10 minutes a tab session. If the API is slow,
// limited or blocked, the build's number stays. Without a count, the mark and "GitHub".
// The wide form, for the phone menu, is a full-width button that spells it out.
// The mark's path is the GitHub icon from Starlight's icon set (MIT).
import { links, GITHUB } from '../lib/links.mjs';
import { STARS, starLabel } from '../lib/github.mjs';
const { wide = false, class: cls = '' } = Astro.props;
const n = starLabel(STARS);
const label = n == null ? 'Napwake on GitHub' : `Napwake on GitHub: ${STARS} ${STARS === 1 ? 'star' : 'stars'}`;
const mark = 'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z';
---
<a class:list={['gh', wide && 'gh--wide', cls]} href={links.repo.href} aria-label={label} title={label} rel="noopener" data-repo={`${GITHUB.owner}/${GITHUB.repo}`}>
  <svg class="gh__mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={mark} /></svg>
  {wide
    ? <span class="gh__word">GitHub<span class="gh__n">{n != null && ` · ${n} ${STARS === 1 ? 'star' : 'stars'}`}</span></span>
    : <span class="gh__n">{n ?? 'GitHub'}</span>}
</a>
<script>
  const KEY = 'napwake-stars';
  const fmt = (n) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '')}k` : String(n));
  const show = (n) => {
    const word = n === 1 ? 'star' : 'stars';
    for (const a of document.querySelectorAll('a.gh[data-repo]')) {
      const label = `Napwake on GitHub: ${n} ${word}`;
      a.setAttribute('aria-label', label);
      a.title = label;
      const s = a.querySelector('.gh__n');
      if (s) s.textContent = a.classList.contains('gh--wide') ? ` · ${fmt(n)} ${word}` : fmt(n);
    }
  };
  const repo = document.querySelector('a.gh[data-repo]')?.dataset.repo;
  if (repo) {
    let cached = null;
    try { cached = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch {}
    if (cached?.repo === repo && Date.now() - cached.t < 600_000) show(cached.n);
    else fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!Number.isInteger(d?.stargazers_count)) return;
        show(d.stargazers_count);
        try { sessionStorage.setItem(KEY, JSON.stringify({ repo, n: d.stargazers_count, t: Date.now() })); } catch {}
      })
      .catch(() => {});
  }
</script>
<style>
  .gh { display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 8px; border-radius: var(--radius-md); color: var(--muted); text-decoration: none; font: 700 14px/1 var(--font-sans); transition: color var(--duration-ui-short) var(--ease-calm), background var(--duration-ui-short) var(--ease-calm); }
  .gh:hover { color: var(--text); background: var(--code-bg); }
  .gh:focus-visible { box-shadow: var(--ring); }
  .gh__mark { flex: none; }
  .gh__n { font: 700 13px/1 var(--font-mono); letter-spacing: .01em; font-variant-numeric: tabular-nums; }
  .gh--wide { height: 42px; justify-content: center; padding: 0 14px; border: 1px solid var(--line); color: var(--text); }
  .gh--wide .gh__n { font: inherit; color: var(--muted); }
</style>
