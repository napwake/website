---
// One weekday of one workload with autoResume on: when people use it, and what Napwake does.
// An illustration of the pattern the docs' forecast simulator tests (busy 09:10 to 17:30), not a measurement.
import { code } from '../lib/text.mjs';
const pct = (h, m = 0) => `${((h + m / 60) / 24) * 100}%`;
const use = { from: [9, 10], to: [17, 30] };
const segs = [
  { state: 'asleep', from: [0, 0], to: [8, 45], word: 'asleep' },
  { state: 'waking', from: [8, 45], to: [9, 0], word: '' },
  { state: 'awake', from: [9, 0], to: [18, 30], word: 'awake' },
  { state: 'asleep', from: [18, 30], to: [24, 0], word: 'asleep' },
];
const marks = [
  { at: [8, 45], n: '1', time: '08:45', text: '`autoResume` wakes it, 15 minutes before an hour the forecast expects to be busy. Nobody waits.' },
  { at: [9, 10], n: '2', time: '09:10', text: 'The first person opens it, and finds it awake.' },
  { at: [18, 30], n: '3', time: '18:30', text: '`idleAfter` runs out an hour after the last use at 17:30, and Napwake pauses it.' },
];
const ticks = [0, 3, 6, 9, 12, 15, 18, 21, 24];
const w = (a, b) => `calc(${pct(...b)} - ${pct(...a)})`;
---
<figure class="day">
  <div class="day__plot" role="img" aria-label="One weekday of one workload. It's asleep until 08:45, when autoResume wakes it. People use it from 09:10 to 17:30. It's awake until 18:30, when it's paused an hour after the last use, and asleep overnight.">
    <div class="day__row">
      <span class="day__lab">People</span>
      <div class="day__track">
        <span class="day__use" style={`left:${pct(...use.from)};width:${w(use.from, use.to)}`}>in use</span>
        {marks.map((m) => <span class="day__line" style={`left:${pct(...m.at)}`} aria-hidden="true"></span>)}
      </div>
    </div>
    <div class="day__row">
      <span class="day__lab">Napwake</span>
      <div class="day__track">
        {segs.map((s) => <span class={`day__seg day__seg--${s.state}`} style={`left:${pct(...s.from)};width:${w(s.from, s.to)}`}>{s.word && <i>{s.word}</i>}</span>)}
        {marks.map((m) => <span class="day__line" style={`left:${pct(...m.at)}`} aria-hidden="true"></span>)}
      </div>
    </div>
    <div class="day__row day__row--axis">
      <span class="day__lab"></span>
      <div class="day__track day__axis">
        {ticks.map((t) => <span style={`left:${pct(t)}`}>{String(t).padStart(2, '0')}:00</span>)}
        {marks.map((m, i) => <b class:list={['day__pin', i === 1 && 'day__pin--low']} style={`left:${pct(...m.at)}`}>{m.n}</b>)}
      </div>
    </div>
  </div>
  <ol class="day__notes">
    {marks.map((m) => <li><b class="day__pin day__pin--inline" aria-hidden="true">{m.n}</b><span><b class="mono">{m.time}</b> <Fragment set:html={code(m.text)} /></span></li>)}
  </ol>
  <figcaption>An illustration, with no measured data. People use this workload from 09:10 to 17:30 on weekdays, the pattern the forecast’s simulator tests. <code>autoResume</code> is on, and <code>idleAfter</code> is the default hour.</figcaption>
</figure>
<style>
  .day { margin: 0; }
  .day__plot { position: relative; padding: var(--space-6) var(--space-6) var(--space-4); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); --lab: 86px; }
  .day__row { display: grid; grid-template-columns: var(--lab) minmax(0, 1fr); align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
  .day__lab { font: 700 12px/1.6 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .day__track { position: relative; height: 34px; }
  .day__use { position: absolute; top: 4px; bottom: 4px; background: var(--code-bg); border: 1px solid var(--line); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font: 400 13px/1 var(--font-mono); color: var(--text); }
  .day__seg { position: absolute; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; }
  .day__seg i { font: 700 12px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; font-style: normal; padding: 3px 6px; border-radius: var(--radius-sm); background: var(--surface); }
  .day__seg--asleep { background: var(--glyph-slate); }
  .day__seg--asleep i { color: var(--asleep); }
  .day__seg--waking { background: var(--glyph-amber); }
  .day__seg--awake { background: var(--glyph-room-green); box-shadow: inset 0 0 0 2px var(--glyph-green); }
  .day__seg--awake i { color: var(--awake); }
  .day__seg:first-child { border-radius: var(--radius-sm) 0 0 var(--radius-sm); }
  .day__seg:last-child { border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .day__row--axis { margin: 0; }
  .day__axis { border-top: 1px solid var(--line); }
  .day__axis > span { position: absolute; top: 6px; transform: translateX(-50%); font: 400 12px/1 var(--font-mono); color: var(--muted); }
  .day__axis > span:first-child { transform: none; }
  .day__axis > span:nth-child(9) { transform: translateX(-100%); }
  .day__pin { position: absolute; top: 22px; transform: translateX(-50%); display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--brand); color: var(--bg); font: 700 11px/1 var(--font-mono); }
  .day__pin--inline { position: static; transform: none; flex: none; margin-top: 2px; }
  .day__line { position: absolute; top: -6px; bottom: -6px; width: 0; border-left: 1px dashed var(--muted); z-index: 1; }
  .day__axis .day__pin { z-index: 2; }
  .day__pin--low { top: 46px; }
  .day__axis { height: 72px; }
  .day__notes { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .day__notes li { display: flex; gap: var(--space-3); font-size: 15px; line-height: 1.5; color: var(--muted); }
  .day__notes .mono { color: var(--text); }
  @media (max-width: 760px) {
    .day__plot { padding: var(--space-4) var(--space-3) var(--space-3); --lab: 0px; }
    .day__row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .day__lab:empty { display: none; }
    .day__axis > span:nth-child(even) { display: none; }
    .day__use { font-size: 11px; }
    .day__seg i { font-size: 10px; padding: 2px 4px; }
    .day__notes { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  }
</style>
