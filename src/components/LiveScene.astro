---
// The home page's scene: a corridor of rooms at night, one door per environment, and the doorman
// beside staging through one true cycle: in use, idle for idleAfter, paused, woken by a request.
// The still rooms are drawn once; only staging's door and the doorman change between the four steps.
// Every step's words are always on the page; the picture follows the step. Reduced motion: no autoplay.
import { corridor, corridorWidth } from '../lib/art.mjs';
import { code } from '../lib/text.mjs';
import StateDoor from './StateDoor.astro';

const W = 1800, H = 420, sc = 1.25, P = 5;
const rooms = [
  { state: 'asleep', label: 'dev' }, { state: 'asleep', label: 'qa' }, { state: 'awake', label: 'pr-38', guest: true },
  { state: 'asleep', label: 'pr-41' }, { state: 'asleep', label: 'demo' }, { state: 'awake', label: 'staging' },
  { state: 'awake', label: 'pr-42', guest: true }, { state: 'asleep', label: 'pr-57' }, { state: 'asleep', label: 'preview-7' },
  { state: 'awake', label: 'pr-60', guest: true }, { state: 'asleep', label: 'perf' }, { state: 'asleep', label: 'sandbox' },
];
// centre the doorman's door, so a phone's crop keeps him and his door in view
const dw = 78 * sc, gap = 30 * sc, pgap = 112 * sc;
const x0 = Math.round((W / 2 - (P * (dw + gap) + (pgap - gap) + dw / 2)) * 100) / 100;
void corridorWidth;

const steps = [
  { key: 'awake', state: 'awake', pose: 'duty', word: 'Awake', title: 'In use',
    text: 'Someone is working on staging. Napwake keeps its activity clock from CPU, deploys, your tools’ annotations and Prometheus queries, such as request rate.' },
  { key: 'idle', state: 'awake', pose: 'watch', word: 'Idle', title: 'No sign of use',
    text: 'It has shown no sign of use for `idleAfter`, one hour by default. No schedule decides this. The clock does.' },
  { key: 'asleep', state: 'asleep', pose: 'lights', word: 'Asleep', title: 'Paused',
    text: 'Napwake scales it to zero. The Deployment, its Services and its data stay. Only the pods go.' },
  { key: 'waking', state: 'waking', pose: 'door', word: 'Waking up', title: 'A request wakes it',
    text: 'Someone on the team opens staging, behind your VPN. The doorman holds the request while it starts, then passes it through.' },
];

const base = corridor({ w: W, h: H, rooms, x0, sc, doormanAt: P, include: (i) => i !== P, doorman: false });
const layers = steps.map((s) => corridor({
  // in use, someone is in staging's light; idle, the light is on for nobody (the scan report's building says the same)
  w: W, h: H, rooms: rooms.map((r, i) => (i === P ? { ...r, state: s.state, guest: s.key === 'awake' } : r)), x0, sc, doormanAt: P, pose: s.pose,
  include: (i) => i === P, wall: false, breathe: true, props: s.pose === 'watch',
}));
const start = steps.length - 1;
---
<section class="live" aria-labelledby="live-title" data-live>
  <h2 id="live-title" class="visually-hidden">What Napwake does with one environment</h2>
  <div class="live__band">
    <svg class="live__art" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" role="img"
      aria-label="A corridor of twelve rooms at night, one per environment: most are asleep, a few are awake. Staging's door, with the doorman beside it, changes through the four steps listed below."
      focusable="false">
      <g set:html={base} />
      {layers.map((l, i) => <g class="live__beat" data-beat={i} aria-hidden="true" data-on={i === start ? '' : undefined} set:html={l} />)}
    </svg>
  </div>
  <div class="wrap">
    <ol class="live__steps">
      {steps.map((s, i) => (
        <li>
          <button type="button" class="live__step" data-step={i} aria-pressed={i === start ? 'true' : 'false'}>
            <span class={`live__word nw-badge nw-badge--${s.state}`}><StateDoor state={s.state} size={18} /><span>{String(i + 1).padStart(2, '0')} · {s.word}</span></span>
            <span class="live__title">{s.title}</span>
            <span class="live__text" set:html={code(s.text)} />
          </button>
        </li>
      ))}
    </ol>
    <div class="live__ctl">
      <button type="button" class="live__play" data-play hidden aria-label="Pause the scene">Pause</button>
      <span class="live__note">The rooms are examples: <code>kubectl napwake status</code> shows yours.</span>
    </div>
  </div>
</section>

<style>
  .live { padding: 0 0 var(--space-12); }
  .live__band { background: var(--scene-wall); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .live__art { width: 100%; height: clamp(260px, 26vw, 420px); }
  .live__beat { opacity: 0; transition: opacity var(--duration-ui-long) var(--ease-calm); }
  .live__beat[data-on] { opacity: 1; }
  .live__beat :global(.wedge) { opacity: var(--light-wedge); transform-box: fill-box; transform-origin: 0 0; }
  .live__beat[data-on] :global(.wedge) { animation: breathe var(--duration-breathe) var(--ease-breathe) infinite; }
  @keyframes breathe { 50% { opacity: .3; transform: scaleX(.88); } }

  .live__steps { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); counter-reset: none; }
  .live__step { all: unset; box-sizing: border-box; display: grid; gap: var(--space-2); align-content: start; width: 100%; height: 100%; padding: var(--space-4) var(--space-4) var(--space-4); border-radius: var(--radius-lg); border: 1px solid transparent; cursor: pointer; position: relative; }
  .live__step::before { content: ""; position: absolute; left: var(--space-4); right: var(--space-4); top: 0; height: 2px; background: var(--line); }
  .live__step[aria-pressed="true"] { background: var(--surface); border-color: var(--line); }
  .live__step[aria-pressed="true"]::before { background: var(--action); }
  .live__step:hover .live__title { color: var(--link); }
  .live__step:hover:not([aria-pressed="true"]) { border-color: var(--line); }
  .live__step:focus-visible { box-shadow: var(--ring); }
  .live__title { font: 700 17px/1.35 var(--font-sans); color: var(--text); }
  .live__text { font-size: 15px; line-height: 1.5; color: var(--muted); }
  .live__step[aria-pressed="true"] .live__text { color: var(--text); }
  .live__ctl { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-4); flex-wrap: wrap; }
  .live__play { font: 700 12px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 7px 10px; cursor: pointer; }
  .live__play:hover { color: var(--text); border-color: var(--muted); }
  .live__note { font-size: 14px; color: var(--muted); }
  @media (max-width: 900px) { .live__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .live__steps { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .live__step { padding: var(--space-3) var(--space-2) var(--space-3) var(--space-4); border-radius: var(--radius-md); }
    .live__step::before { left: 0; right: auto; top: var(--space-3); bottom: var(--space-3); width: 2px; height: auto; }
    .live__step:not([aria-pressed="true"]) .live__text { display: none; }
  }
</style>

<script>
  const STEP_MS = 4800;
  for (const root of document.querySelectorAll<HTMLElement>('[data-live]')) {
    const beats = [...root.querySelectorAll<SVGGElement>('.live__beat')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.live__step')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let at = beats.findIndex((b) => b.hasAttribute('data-on'));
    let timer: number | undefined;
    let playing = false;
    const show = (i: number) => {
      at = (i + beats.length) % beats.length;
      beats.forEach((b, j) => b.toggleAttribute('data-on', j === at));
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === at)));
    };
    const stop = () => { playing = false; clearInterval(timer); play.textContent = 'Play'; play.setAttribute('aria-label', 'Play the scene'); };
    const start = () => {
      if (still.matches) return stop();
      playing = true; clearInterval(timer);
      timer = window.setInterval(() => { if (!document.hidden) show(at + 1); }, STEP_MS);
      play.textContent = 'Pause'; play.setAttribute('aria-label', 'Pause the scene');
    };
    // Hover or keyboard focus previews a state after a short pause, so the scene doesn't
    // jump as the pointer crosses the cards; leaving puts back what was there. A click pins it.
    const INTENT_MS = 150;
    let pending: number | undefined;
    let previewing = false;
    let resumeAt = at;
    let resumePlaying = false;
    const preview = (j: number) => {
      clearTimeout(pending);
      pending = window.setTimeout(() => {
        if (!previewing) { resumeAt = at; resumePlaying = playing; }
        previewing = true;
        clearInterval(timer);
        show(j);
      }, INTENT_MS);
    };
    const restore = () => {
      clearTimeout(pending);
      pending = window.setTimeout(() => {
        if (!previewing) return;
        previewing = false;
        show(resumeAt);
        if (resumePlaying) start();
      }, INTENT_MS);
    };
    buttons.forEach((b, j) => {
      b.addEventListener('click', () => { clearTimeout(pending); previewing = false; show(j); stop(); });
      b.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') preview(j); });
      b.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') restore(); });
      b.addEventListener('focus', () => { if (b.matches(':focus-visible')) preview(j); });
      b.addEventListener('blur', () => restore());
    });
    play.addEventListener('click', () => { clearTimeout(pending); previewing = false; playing ? stop() : start(); });
    play.hidden = still.matches;
    // the cycle starts at the waking door, which is also the still picture under reduced motion
    if (!still.matches) start(); else stop();
    still.addEventListener('change', () => { play.hidden = still.matches; still.matches ? stop() : start(); });
  }
</script>
