---
// /blog/: posts, newest first; the newest as a card in the launch card's colours. Built only once the blog
// has a post (BLOG in src/lib/blog.mjs), so a site with none has no /blog/.
import Base from '../../layouts/Base.astro';
import Pose from '../../components/Pose.astro';
import { POSTS, BLOG, fmtDate } from '../../lib/blog.mjs';

export function getStaticPaths() {
  return BLOG ? [{ params: { index: undefined } }] : [];
}
const [lead, ...rest] = POSTS;
---
<Base title="Blog">
  <section class="intro">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1 class="display-1 intro__h1">From the front desk.</h1>
      <p class="lede">Release announcements from Napwake, and how it’s built. <a href="/blog/rss.xml">RSS feed</a></p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {lead && (
        <>
          <a class="lead" href={`/blog/${lead.slug}/`}>
            <div class="lead__text">
              {lead.draft && <p class="draft">Draft</p>}
              <p class="lead__meta"><time datetime={lead.date}>{fmtDate(lead.date)}</time> · {lead.minutes} min read · {lead.author}</p>
              <h2 class="display-2 lead__t">{lead.title}</h2>
              {lead.description && <p class="lead__d">{lead.description}</p>}
              <p class="lead__go">Read the post <span aria-hidden="true">→</span></p>
            </div>
            <div class="lead__art" aria-hidden="true"><Pose name="tip" width={200} /></div>
          </a>
          {rest.length > 0 && (
            <ol class="posts">
              {rest.map((p) => (
                <li><a href={`/blog/${p.slug}/`}><span class="posts__meta"><time datetime={p.date}>{fmtDate(p.date)}</time> · {p.minutes} min read</span><span class="h3">{p.title}{p.draft && <span class="draft draft--inline">Draft</span>}</span>{p.description && <span class="posts__d">{p.description}</span>}</a></li>
              ))}
            </ol>
          )}
        </>
      )}
    </div>
  </section>
</Base>
<style>
  .intro { padding: var(--space-18) 0 var(--space-8); }
  .intro__h1 { margin-bottom: var(--space-6); }
  .intro .lede a { font-size: 16px; margin-left: var(--space-2); }
  /* the newest post, in the launch card's colours whatever the theme */
  .lead { display: grid; grid-template-columns: minmax(0, 1fr) 260px; align-items: end; gap: var(--space-8); padding: var(--space-12) var(--space-12) 0; background: var(--lamp); color: var(--night); border-radius: var(--radius-xl); text-decoration: none; overflow: hidden; position: relative; }
  .lead::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 26px; background: var(--launch-floor); }
  .lead__text { padding-bottom: var(--space-12); position: relative; z-index: 1; }
  .lead__art { position: relative; z-index: 1; display: grid; place-items: end center; margin-bottom: 4px; }
  .lead__meta { font: 400 14px/1.4 var(--font-mono); margin: 0 0 var(--space-4); }
  .lead__t { font-size: 64px; margin: 0 0 var(--space-4); }
  .lead__d { font-size: 18px; line-height: 1.5; max-width: 34em; margin: 0 0 var(--space-6); }
  .lead__go { font-weight: 700; margin: 0; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .lead:hover .lead__go { text-decoration-thickness: 3px; }
  .lead:focus-visible { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--action); }
  .draft { display: inline-block; margin: 0 0 var(--space-4); padding: 4px 8px; border: 1px dashed currentColor; border-radius: var(--radius-sm); font: 700 12px/1.4 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .draft--inline { margin: 0 0 0 var(--space-2); vertical-align: middle; color: var(--accent-text); }
  .posts { list-style: none; margin: var(--space-8) 0 0; padding: 0; display: grid; gap: 0; }
  .posts a { display: grid; gap: var(--space-2); padding: var(--space-6) 0; border-top: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .posts__meta { font: 400 13px/1.4 var(--font-mono); color: var(--muted); }
  .posts a:hover .h3 { color: var(--link); }
  .posts__d { color: var(--muted); }
  @media (max-width: 760px) {
    .lead { grid-template-columns: minmax(0, 1fr); padding: var(--space-8) var(--space-6) 0; gap: 0; }
    .lead__text { padding-bottom: var(--space-4); }
    .lead__art { place-items: end end; }
    .lead__art :global(svg) { width: 130px; }
    .lead__t { font-size: 46px; }
  }
  @media (max-width: 600px) { .intro { padding: var(--space-12) 0 var(--space-6); } }
</style>
