---
// Home: whoever lands here sees at once how to scan their cluster and what they get, then what the report
// shows, then how to install Napwake and pause one workload, then one idea per section (Tobi, 2026-10-31).
// Every claim about Napwake is from the product's docs (docs/index.md, concepts/, getting-started/), checked
// 2026-10-22, and the scan's from the plugin page and the scan's own output, checked 2026-10-31.
import Base from '../layouts/Base.astro';
import LiveScene from '../components/LiveScene.astro';
import Terminal from '../components/Terminal.astro';
import ScanDemo from '../components/ScanDemo.astro';
import ScanResult from '../components/ScanResult.astro';
import TwoWays from '../components/TwoWays.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import StateBadge from '../components/StateBadge.astro';
import StateDoor from '../components/StateDoor.astro';
import Room from '../components/Room.astro';
import Pose from '../components/Pose.astro';
import WakingMock from '../components/WakingMock.astro';
import AsleepMock from '../components/AsleepMock.astro';
import { links } from '../lib/links.mjs';
import { corridor } from '../lib/art.mjs';
import { software } from '../lib/jsonld.mjs';
import { LATEST_TAG } from '../lib/changelog.mjs';
import { HEADLINE, TRY } from '../lib/site.mjs';

// The design system's scan icon (project/assets/Icons/icon-scan.svg): a clipboard before a door, in brand.
const scanIcon = '<path d="M3 21V8.5a5.5 5.5 0 0 1 11 0V21Z" opacity=".4"/><rect x="11" y="9" width="10" height="13" rx="1.6"/><rect x="13.5" y="7.6" width="5" height="2.6" rx="1.2"/><path d="M13.5 13.5h5M13.5 17h3.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>';

// Installing, as the scan's own next steps say it (cmd/kubectl-napwake, the example's output in
// src/content/examples/scan-first.txt) and the docs' Installation and Quickstart pages. The chart's version is
// LATEST_TAG's without its v (src/lib/changelog.mjs): the newest full release, or the newest release candidate
// while there's none, so the command works today. 0.2.0-rc.11 until 0.2.0 ships, then never a later candidate.
const chart = (LATEST_TAG?.tag || 'v0.2.0').replace(/^v/, '');
const helm = `helm install napwake \\\n  oci://ghcr.io/napwake/charts/napwake \\\n  --version ${chart} \\\n  --namespace napwake-system \\\n  --create-namespace \\\n  -f napwake-values.yaml`;
// The values file, made by the copy so nobody writes one by hand for one line (Tobi, 2026-10-31, cmo-076). >> keeps
// a file that is already there, such as one with prometheus.url, and Helm takes the last timezone line (cto-074).
// printf, not echo: its leading line break keeps a file whose last line has no break, such as a comment, from
// swallowing the timezone line, which Helm would then miss and install on UTC (cto-079, the product's #118).
// Broken before the redirect, as the helm line is at its flags, so both fit a phone at 390 and copy as shown.
const values = `printf '\\ntimezone: Europe/London\\n' \\\n  >> napwake-values.yaml`;

const states = [
  { state: 'asleep', text: 'Scaled to zero. The Deployment or StatefulSet stays, and so do its Services, its PVCs and their data. Only the pods are removed. Its Services now point at the doorman.' },
  { state: 'waking', text: 'A request, an activity annotation or the forecast woke it. Its replicas are being restored, and the doorman holds requests until a pod is Ready.' },
  { state: 'awake', text: 'Running as usual, with nothing in front of it. Its activity clock runs. After <code>idleAfter</code> with no sign of use, an hour by default, it’s paused again.' },
  { state: 'error', text: 'Something stops Napwake doing its job, and the door gets a note. <code>kubectl napwake status</code> says what to fix.' },
];

// How a wake works: two doors, side by side. Facts from the docs' click-to-wake branch
// (concepts/wake-on-request, guides/public-previews) and the asleep page's hand-off, 2026-10-23.
const doors = [
  {
    id: 'door-private', where: 'Behind your VPN or SSO', what: 'The first request wakes it.', mock: 'waking',
    steps: [
      { state: 'waking', text: 'Someone opens staging. The doorman holds the first request, and wakes it.' },
      { state: 'waking', text: 'Their browser gets the waking page at once. It reloads every 3 seconds.' },
      { state: 'awake', text: 'A pod is Ready, and the page opens the app.' },
    ],
  },
  {
    id: 'door-public', where: 'On a public URL', what: 'With <code>napwake.dev/wake: ask</code>, a person wakes it.', mock: 'asleep',
    steps: [
      { state: 'asleep', text: 'Someone opens the preview. The doorman asks first. Their browser gets the asleep page, and nothing wakes.' },
      { state: 'waking', text: 'They press <b>Wake it</b>. That wakes it, and the waking page carries on.' },
      { state: 'awake', text: 'A pod is Ready, and the page opens the app.' },
    ],
  },
];
const WORD = { asleep: 'Asleep', waking: 'Waking up', awake: 'Awake' };

// everyone else, per door, with one `both` cell when the two doors agree
const others = [
  { who: 'Scripts, API clients and database drivers',
    private: { state: 'waking', html: 'Held until a pod is Ready, for up to <code>wake.maxWait</code>, 2 minutes by default. After that, the connection is closed and the wake goes on.' },
    public: { state: 'asleep', html: 'Turned away. Over HTTP, a <code>503</code> that says how to wake it. Nothing wakes.' } },
  { who: 'Known probes, scrapers and uptime monitors', both: { state: 'asleep', html: 'A <code>503</code> either way, or a <code>200</code> for Google’s load balancer. Nothing wakes.' } },
  { who: 'Tooling, by an annotation or <code>kubectl napwake wake</code>', both: { state: 'waking', html: 'Wakes it, either way.' } },
  { who: 'The forecast, if you turn it on', both: { state: 'waking', html: 'Wakes it 15 minutes before an hour it expects busy, either way.' } },
];

// 07, who it's for: decision 0024's three groups, in its order, each a choice with one next step (brief A5).
// Each card's picture is one door and one of the doorman's poses, drawn by the rig on the same wall and floor, so
// the three read as doors on one corridor. The poses are the design system's for the job each card names: lights
// (Napwake pauses what nobody uses), rounds (the scan) and ask (a public preview). The svg slices from the bottom,
// so a wider card shows more wall and the floor stays put. It's wide enough that height decides the scale at every
// card shape the page has, up to a stacked card 700 px wide, so no head is ever cut.
const CW = 1000, CH = 236, CFY = 202, CDOOR = 512;
const choices = [
  {
    key: 'cron', pose: 'lights', state: 'asleep', shift: -72, title: 'You have a cron',
    text: 'Napwake goes by use, not the hour. The first request wakes staging, so nobody brings it back by hand.',
    next: 'See what it misses', href: '#schedule',
    alt: 'Napwake pauses what nobody is using, drawn as the doorman at the switch beside a shut door.',
  },
  {
    key: 'none', pose: 'rounds', state: 'awake', shift: -60, title: 'You have nothing yet',
    text: 'One read-only scan shows what your idle workloads cost, in a report you can send your team.',
    next: 'Scan your cluster', href: links.scan.href,
    alt: 'Napwake checks what’s idle, drawn as the doorman with a clipboard beside an open, empty door.',
  },
  {
    key: 'previews', pose: 'ask', state: 'asleep', shift: 1, title: 'You run previews',
    text: 'One per pull request, used at hours no schedule can guess. On a public URL, Napwake can ask before waking one.',
    next: 'Set up public previews', href: links.guide('preview-environments').href,
    alt: 'The doorman asks before waking a preview, his hand flat on its shut door.',
  },
].map((c) => ({
  ...c,
  svg: corridor({
    w: CW, h: CH, floorY: CFY, x0: CDOOR - 82, sc: 1, rooms: [{ state: c.state, label: '' }], doormanAt: 0, pose: c.pose,
    labels: false, stateLabels: false,
    // the switch and the clipboard are the jobs' props. He stands clear of the door, with the switch on the wall
    // beside its frame; at the ask, his hand lies flat on the leaf, as on the compare page.
    props: c.pose === 'lights' || c.pose === 'rounds', shiftDoorman: c.shift,
  }),
}));
---
<Base jsonld={[software()]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__head">
        <p class="eyebrow">Open source · No cron to write</p>
        <h1 id="hero-title" class="display-1 hero__h1">{HEADLINE}</h1>
      </div>
      <div class="hero__row">
        <div class="hero__scan">
          <p class="lede hero__lede">{TRY}</p>
          <Terminal class="hero__term" bar="Install the plugin, then scan" notes={['Install the kubectl plugin', 'Scan your cluster']} command={['brew install napwake/tap/kubectl-napwake', 'kubectl napwake scan']} label="Install the kubectl plugin with Homebrew, then scan your cluster" />
          <p class="hero__ro"><svg class="hero__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><g fill="var(--brand)" set:html={scanIcon} /></svg><span><b>Read-only.</b> Nothing runs on your cluster.</span></p>
          <p class="hero__other">Homebrew, on macOS and Linux. Other ways: <Link to={links.pluginInstall}>Krew</Link> · <Link to={links.pluginInstall}>download</Link></p>
          <div class="actions hero__actions">
            <Button to={links.scan} variant="primary">Scan your cluster</Button>
            <a class="nw-btn nw-btn--secondary" href="/examples/scan-report/">See an example report</a>
          </div>
        </div>
        <div class="hero__result">
          <ScanResult />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="scan-title">
    <div class="wrap">
      <div class="section__head head--wide">
        <p class="eyebrow"><span class="plate">01</span> What you’ll see</p>
        <h2 id="scan-title" class="display-2">A report you can send your team.</h2>
        <p>A team that works 10 hours a day, five days a week, uses staging 50 of 168 hours. The other 70%, it’s idle.</p>
      </div>
      <ScanDemo />
      <ol class="scan__notes">
        <li>It shows what’s idle right now, and what that costs while it runs, at your nodes’ list prices.</li>
        <li>Switch it to <b>With Napwake</b> to see the idle ones paused. The last week, replayed from Prometheus, says what that would have freed.</li>
        <li>It ends with your next steps, with your own workloads’ names. Install Napwake, then measure one workload, which pauses nothing.</li>
      </ol>
      <p class="scan__send"><b>Send it to your team.</b> It’s one self-contained file, with nothing loaded from elsewhere, and it prints cleanly to PDF. <a href="/examples/scan-report/" target="_blank" rel="noopener">Open the example report in a new tab <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section class="section guess" id="schedule" aria-labelledby="guess-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">02</span> If you already have a cron</p>
        <h2 id="guess-title" class="display-2">A schedule guesses. Napwake watches.</h2>
        <p>A cron leaves staging up while nobody’s using it, and down when someone needs it. Napwake pauses on idleness, and the first request wakes it.</p>
      </div>
    </div>
    <TwoWays>
      <p class="guess__key">Each door is one room at the moment a schedule gets it wrong.</p>
      <p class="guess__more"><a href="/compare/">How it compares</a> runs the whole evening, with a scale-to-zero proxy too, and a table of all three.</p>
    </TwoWays>
  </section>

  <section class="section install" aria-labelledby="install-title">
    <div class="wrap">
      <div class="install__top">
        <div class="install__art"><Pose name="point" alt="The doorman points the way." width={200} /></div>
        <div class="section__head install__head head--wide">
          <p class="eyebrow"><span class="plate">03</span> Then install</p>
          <h2 id="install-title" class="display-2">Install Napwake, and pause one workload.</h2>
          <p>It measures in dry-run first, so nothing pauses until you say so. It never deletes a workload or its data.</p>
        </div>
      </div>
      <ol class="steps">
        <li class="step">
          <div class="step__say">
            <p class="step__n" aria-hidden="true">1</p>
            <h3 class="h3">Install it with Helm</h3>
            <p>Change <code class="fill">Europe/London</code> to your users’ time zone. It needs Kubernetes 1.30 or later, and metrics-server.</p>
            <p class="step__other">Other ways: <Link to={links.installNoHelm}>without Helm</Link> · <Link to={links.installGitOps}>Argo CD or Flux</Link></p>
          </div>
          <Terminal class="step__term" bar="Helm 3.8 or later" fill={['Europe/London']} command={[values, helm]} label="Make the values file with your time zone, then install Napwake with Helm" />
        </li>
        <li class="step">
          <div class="step__say">
            <p class="step__n" aria-hidden="true">2</p>
            <h3 class="h3">Opt one workload in, measuring first</h3>
            <p>The annotation starts it in dry-run, measured and never paused. The label opts it in. <code>kubectl napwake status</code> shows what it measures.</p>
          </div>
          <Terminal class="step__term" bar="Use your workload and namespace" fill={['my-api', 'dev']} command={['kubectl annotate deployment my-api \\\n    -n dev napwake.dev/dry-run=true', 'kubectl label deployment my-api \\\n    -n dev napwake.dev/managed=true']} label="Opt a workload in, in dry-run" />
        </li>
        <li class="step">
          <div class="step__say">
            <p class="step__n" aria-hidden="true">3</p>
            <h3 class="h3">Let it pause</h3>
            <p>Do this once what it measured looks right. After <code>idleAfter</code> with no activity, an hour by default, Napwake pauses it.</p>
          </div>
          <Terminal class="step__term" bar="Ends dry-run for it" fill={['my-api', 'dev']} command="kubectl napwake enable my-api -n dev" label="End dry-run for the workload" />
        </li>
      </ol>
      <div class="install__foot">
        <div class="actions">
          <Button to={links.install} variant="primary">Installation guide</Button>
          <Button to={links.quickstart}>Quickstart</Button>
        </div>
        <p class="licence small muted">Free and open source under <a href={links.apache.href}>Apache 2.0</a>.</p>
      </div>
    </div>
  </section>

  <LiveScene eyebrow="Once it’s on" plate="04">
    <a slot="after" class="live__more" href="/how-it-works/">How it works, in full</a>
  </LiveScene>

  <section class="section fit" id="who" aria-labelledby="fit-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">05</span> Who it’s for</p>
        <h2 id="fit-title" class="display-2">For any environment that isn’t production.</h2>
        <p>For platform and infrastructure engineers who run staging, preview and dev on their own Kubernetes clusters.</p>
      </div>
      <ul class="choices">
        {choices.map((c) => (
          <li class={`choice choice--${c.key}`}>
            <div class="choice__art">
              <svg viewBox={`0 0 ${CW} ${CH}`} preserveAspectRatio="xMidYMax slice" role="img" aria-label={c.alt} focusable="false" set:html={c.svg} />
            </div>
            <div class="choice__body">
              <h3 class="choice__h" id={`choice-${c.key}`}>{c.title}</h3>
              <p>{c.text}</p>
              <a class="choice__next" href={c.href} aria-describedby={`choice-${c.key}`}>{c.next}<span aria-hidden="true">{'\u00a0'}→</span></a>
            </div>
          </li>
        ))}
      </ul>
      <p class="fit__more">See <a href="/compare/">how it compares</a> with a schedule and a <span class="nowrap">scale-to-zero</span> proxy, or read the <a href="/faq/">FAQ</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="wake-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">06</span> How a wake works</p>
        <h2 id="wake-title" class="display-2">Behind your VPN, the first request wakes it.<br /> On a public URL, it can ask first.</h2>
        <p>A paused workload’s Services point at the doorman, Napwake’s small proxy. Behind a VPN, single sign-on or an allowlist, he wakes it on the first request. On a public URL, most requests are robots. Set <code>napwake.dev/wake: ask</code> there, and the doorman asks a person first. Either way, the app and its Ingress don’t change.</p>
      </div>
      <div class="doors">
        {doors.map((d) => (
          <div class="door">
            <div class="door__head">
              <h3 id={d.id} class="h3">{d.where}</h3>
              <p class="door__what" set:html={d.what} />
            </div>
            <div class="door__mock">{d.mock === 'waking' ? <WakingMock /> : <AsleepMock />}</div>
            <ol class="door__steps">
              {d.steps.map((s, i) => (
                <li>
                  <span class={`nw-badge nw-badge--${s.state}`}><StateDoor state={s.state} size={18} /><span>{String(i + 1).padStart(2, '0')} · {WORD[s.state]}</span></span>
                  <p set:html={s.text} />
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <div class="table-wrap others">
        <table>
          <caption class="visually-hidden">What everyone else gets while a workload is asleep, behind a VPN and on a public URL set to ask</caption>
          <thead><tr><th scope="col">Everyone else</th><th scope="col">Behind your VPN or SSO</th><th scope="col">On a public URL, set to ask</th></tr></thead>
          <tbody>
            {others.map((o) => (
              <tr>
                <th scope="row" set:html={o.who} />
                {o.both
                  ? <td colspan="2" class="others__both" data-label="Either way"><span class="others__out"><StateDoor state={o.both.state} size={18} /><span set:html={o.both.html} /></span></td>
                  : [
                      <td data-label="Behind your VPN or SSO"><span class="others__out"><StateDoor state={o.private.state} size={18} /><span set:html={o.private.html} /></span></td>,
                      <td data-label="On a public URL, set to ask"><span class="others__out"><StateDoor state={o.public.state} size={18} /><span set:html={o.public.html} /></span></td>,
                    ]}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted wake__foot">It needs a readiness probe that passes only once the app can serve. Then the held request reaches an app that’s ready. Behind your VPN or SSO, the doorman can’t read an HTTPS health check, so each one wakes it. <Link to={links.concept('wake-on-request')}>Wake on request</Link>, in the docs, has the cases where a caller sees something else.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="states-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">07</span> Four states</p>
        <h2 id="states-title" class="display-2">Paused, resuming, running, or it needs you.</h2>
        <p>Each state is drawn as a door. Shut is asleep, ajar is waking up, open is awake, and a note means it needs you. Each card gives the plain word, then the one <code>kubectl napwake status</code> prints.</p>
      </div>
      <ul class="states">
        {states.map((s) => (
          <li class="card state">
            <Room state={s.state} w={240} h={232} class="state__art" />
            <StateBadge state={s.state} vocabulary="both" />
            <p set:html={s.text} />
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>

<style>
  /* the hero: the headline says what Napwake does, then try it first: the two commands, each labelled, and what they show */
  .hero { padding: var(--space-12) 0 var(--space-18); }
  .hero__head { max-width: 62rem; }
  .hero__h1 { max-width: 13.5em; }
  /* Sections 01 and 02: their one-sentence lines on one line wherever they fit, as Tobi asked; balanced where they
     can't, so no word sits alone. The longer intros below keep the 46em measure. */
  .head--wide { max-width: none; }
  .head--wide > p:not(.eyebrow) { text-wrap: balance; }
  /* One step under display-1 from tablets up (Tobi, 2026-10-31): a full sentence across the page, beside the card's
     own big number, read as shouting at 72. 56 is what tablets already get, and phones keep theirs. */
  @media (min-width: 901px) { .hero__h1 { font-size: 56px; } }
  .hero__lede { margin: 0 0 var(--space-6); max-width: 34em; }
  .hero__row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-12); align-items: start; margin-top: var(--space-8); }
  .hero__scan :global(.hero__term .nw-term) { font-size: 14px; padding: var(--space-4) 18px 18px; }
  .hero__lede, .hero__ro span, .hero__other { text-wrap: pretty; }
  .hero__ro { display: flex; align-items: flex-start; gap: var(--space-2); margin: var(--space-4) 0 var(--space-1); }
  .hero__ro b { color: var(--text); }
  .hero__icon { flex: none; margin-top: 1px; }
  .hero__other { margin: 0 0 var(--space-6) 30px; font-size: 15px; color: var(--muted); }
  .hero__actions :global(.nw-btn) { padding-left: 1.5em; padding-right: 1.5em; }
  .hero__result { min-width: 0; }
  .licence { margin: var(--space-3) 0 0; }
  .licence a { color: inherit; }

  .scan__notes { list-style: none; counter-reset: n; margin: var(--space-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
  .scan__notes li { counter-increment: n; position: relative; padding-top: var(--space-8); font-size: 15px; line-height: 1.5; color: var(--muted); }
  .scan__notes li b { color: var(--text); }
  .scan__notes li::before { content: counter(n); position: absolute; top: 0; left: 0; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: var(--bg); font: 700 12px/1 var(--font-mono); }
  .scan__send { margin: var(--space-8) 0 0; padding-top: var(--space-6); border-top: 1px solid var(--line); color: var(--muted); }
  .scan__send b { color: var(--text); }
  .scan__send a { font-weight: 700; margin-left: var(--space-2); white-space: nowrap; }

  .states { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .state { display: grid; gap: var(--space-3); align-content: start; padding: 0 var(--space-6) var(--space-6); overflow: hidden; }
  .state :global(.state__art) { width: calc(100% + 2 * var(--space-6)); max-width: none; height: auto; background: var(--scene-wall); margin: 0 calc(-1 * var(--space-6)) var(--space-3); }
  .state p { margin: 0; color: var(--text); font-size: 16px; }

  /* two doors side by side; subgrid lines up their heads, pictures and steps */
  .doors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto auto auto; column-gap: var(--space-12); row-gap: var(--space-6); }
  .door { display: grid; grid-row: span 3; grid-template-rows: subgrid; min-width: 0; }
  .door__head { border-top: 2px solid var(--line); padding-top: var(--space-4); }
  .door__head .h3 { margin-bottom: var(--space-1); }
  .door__what { margin: 0; color: var(--muted); }
  .door__mock { align-self: start; min-width: 0; }
  .door__steps { list-style: none; margin: var(--space-2) 0 0; padding: 0; }
  .door__steps li { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--space-4); align-items: baseline; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .door__steps li:first-child { border-top: 0; }
  .door__steps .nw-badge { align-self: start; padding-top: 2px; }
  .door__steps p { margin: 0; font-size: 16px; line-height: 1.5; }

  /* everyone else, per door */
  .others { margin-top: var(--space-12); }
  .others table { table-layout: fixed; font-size: 15px; }
  .others thead th:first-child { width: 30%; }
