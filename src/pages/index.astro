---
// Home: what Napwake is in seconds, then one idea per section.
// Every claim about Napwake is from the product's docs (docs/index.md, concepts/, getting-started/), checked 2026-10-22.
import Base from '../layouts/Base.astro';
import LiveScene from '../components/LiveScene.astro';
import Terminal from '../components/Terminal.astro';
import ScanDemo from '../components/ScanDemo.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import StateBadge from '../components/StateBadge.astro';
import StateDoor from '../components/StateDoor.astro';
import Room from '../components/Room.astro';
import Pose from '../components/Pose.astro';
import WakingMock from '../components/WakingMock.astro';
import AsleepMock from '../components/AsleepMock.astro';
import { links } from '../lib/links.mjs';
import { software } from '../lib/jsonld.mjs';

const states = [
  { state: 'asleep', text: 'Scaled to zero. The Deployment or StatefulSet stays, and so do its Services, its PVCs and their data. Only the pods are removed. Its Services now point at the doorman.' },
  { state: 'waking', text: 'A request, an activity annotation or the forecast woke it. Its replicas are being restored, and requests wait at the door until a pod is Ready.' },
  { state: 'awake', text: 'Running as usual, with nothing in front of it. Its activity clock runs. After <code>idleAfter</code> with no sign of use, an hour by default, it’s paused again.' },
  { state: 'error', text: 'A note pinned on the door. Something stops Napwake doing its job, and <code>kubectl napwake status</code> says what to fix.' },
];

// How a wake works: two doors, side by side. Facts from the docs' click-to-wake branch
// (concepts/wake-on-request, guides/public-previews) and the asleep page's hand-off, 2026-10-23.
const doors = [
  {
    id: 'door-private', where: 'Behind your VPN or SSO', what: 'The first request wakes it.', mock: 'waking',
    steps: [
      { state: 'waking', text: 'Someone opens staging. The doorman holds the first request, and wakes it.' },
      { state: 'waking', text: 'Their browser gets the waking page at once. It reloads every 3 seconds.' },
      { state: 'awake', text: 'A pod is Ready, and the page opens the app.' },
    ],
  },
  {
    id: 'door-public', where: 'On a public URL', what: 'With <code>napwake.dev/wake: ask</code>, a person wakes it.', mock: 'asleep',
    steps: [
      { state: 'asleep', text: 'Someone opens the preview. The doorman asks first. Their browser gets the asleep page, and nothing wakes.' },
      { state: 'waking', text: 'They press <b>Wake it</b>. That wakes it, and the waking page carries on.' },
      { state: 'awake', text: 'A pod is Ready, and the page opens the app.' },
    ],
  },
];
const WORD = { asleep: 'Asleep', waking: 'Waking up', awake: 'Awake' };

// everyone else, per door; one `both` cell when the two doors agree
const others = [
  { who: 'Scripts, API clients and database drivers',
    private: { state: 'waking', html: 'Held until a pod is Ready, for up to <code>wake.maxWait</code>, 2 minutes by default. After that, the connection is closed and the wake goes on.' },
    public: { state: 'asleep', html: 'Turned away. Over HTTP, a <code>503</code> that says how to wake it. Nothing wakes.' } },
  { who: 'Known probes, scrapers and uptime monitors', both: { state: 'asleep', html: 'A <code>503</code> at both doors, or a <code>200</code> for Google’s load balancer. Nothing wakes.' } },
  { who: 'Tooling, by an annotation or <code>kubectl napwake wake</code>', both: { state: 'waking', html: 'Wakes it, at both doors.' } },
  { who: 'The forecast, if you turn it on', both: { state: 'waking', html: 'Wakes it 15 minutes before people usually come, at both doors.' } },
];
---
<Base jsonld={[software()]}>
  <section class="hero">
    <div class="wrap hero__in">
      <p class="eyebrow">Open source · for Kubernetes</p>
      <h1 class="display-1 hero__h1">Non-prod environments that sleep when nobody’s using them, and wake when someone does.</h1>
      <div class="hero__side">
        <p class="lede">Pauses idle Kubernetes workloads in staging, preview and dev, and wakes them on the first request.</p>
        <p class="hero__never"><StateDoor state="asleep" size={20} /> It never deletes a workload or its data.</p>
        <div class="actions">
          <Button to={links.quickstart} variant="primary">Get started</Button>
          <a class="nw-btn nw-btn--secondary" href="/how-it-works/">How it works</a>
        </div>
        <p class="licence small muted">Free and open source under <a href={links.apache.href}>Apache 2.0</a>.</p>
      </div>
    </div>
  </section>

  <LiveScene />

  <section class="section" aria-labelledby="scan-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">01</span> Before you install</p>
        <h2 id="scan-title" class="display-2">One command, and a report you can send your team.</h2>
        <p>A team that works 10 hours a day, five days a week, uses staging 50 of 168 hours. The other 70%, it’s idle. <code>kubectl napwake scan</code> shows your cluster’s own number before you install anything.</p>
      </div>
      <ScanDemo />
      <ol class="scan__notes">
        <li><b>Read-only.</b> It runs with your kubeconfig, and installs nothing in the cluster.</li>
        <li><b>Lit, no one seen:</b> your cluster as a hotel at night, with what’s idle right now lit up, and what it costs while it runs, at your nodes’ list prices.</li>
        <li><b>With Napwake:</b> the lights go off in the rooms with no one seen, and the last week, replayed from Prometheus, says what pausing would have freed.</li>
      </ol>
      <p class="scan__send"><b>Send it to your team:</b> it’s one self-contained file, with nothing loaded from elsewhere, and it prints cleanly to PDF. <a href="/examples/scan-report/" target="_blank" rel="noopener">Open the example report in a new tab <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="states-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">02</span> Four doors</p>
        <h2 id="states-title" class="display-2">Every workload is a door.</h2>
        <p>Shut is asleep, ajar is waking up, open is awake. A note on the door means it needs you. The plain word first, then the one <code>kubectl napwake status</code> prints.</p>
      </div>
      <ul class="states">
        {states.map((s) => (
          <li class="card state">
            <Room state={s.state} w={240} h={232} class="state__art" />
            <StateBadge state={s.state} vocabulary="both" />
            <p set:html={s.text} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="wake-title">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow"><span class="plate">03</span> How a wake works</p>
        <h2 id="wake-title" class="display-2">Private doors open on a request.<br /> Public ones can ask first.</h2>
        <p>Behind a VPN, single sign-on or an allowlist, the first request wakes a paused workload. On a public URL, most requests are robots. Set <code>napwake.dev/wake: ask</code> there, and the doorman asks first. Either way, the app and its Ingress don’t change.</p>
      </div>
      <div class="doors">
        {doors.map((d) => (
          <div class="door">
            <div class="door__head">
              <h3 id={d.id} class="h3">{d.where}</h3>
              <p class="door__what" set:html={d.what} />
            </div>
            <div class="door__mock">{d.mock === 'waking' ? <WakingMock /> : <AsleepMock />}</div>
            <ol class="door__steps">
              {d.steps.map((s, i) => (
                <li>
                  <span class={`nw-badge nw-badge--${s.state}`}><StateDoor state={s.state} size={18} /><span>{String(i + 1).padStart(2, '0')} · {WORD[s.state]}</span></span>
                  <p set:html={s.text} />
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <div class="table-wrap others">
        <table>
          <caption class="visually-hidden">What everyone else gets while a workload is asleep, behind your VPN or SSO and on a public URL set to ask</caption>
          <thead><tr><th scope="col">Everyone else</th><th scope="col">Behind your VPN or SSO</th><th scope="col">On a public URL, set to ask</th></tr></thead>
          <tbody>
            {others.map((o) => (
              <tr>
                <th scope="row" set:html={o.who} />
                {o.both
                  ? <td colspan="2" class="others__both" data-label="Both doors"><span class="others__out"><StateDoor state={o.both.state} size={18} /><span set:html={o.both.html} /></span></td>
                  : [
                      <td data-label="Behind your VPN or SSO"><span class="others__out"><StateDoor state={o.private.state} size={18} /><span set:html={o.private.html} /></span></td>,
                      <td data-label="On a public URL, set to ask"><span class="others__out"><StateDoor state={o.public.state} size={18} /><span set:html={o.public.html} /></span></td>,
                    ]}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted wake__foot">It needs a readiness probe that passes only once the app can serve, so the held request reaches an app that’s ready. Behind your VPN or SSO, an HTTPS health check can’t be read, and wakes it every time. <Link to={links.concept('wake-on-request')}>Wake on request</Link>, in the docs, has the cases where a caller sees something else.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="fit-title">
    <div class="wrap grid-2 fit">
      <div>
        <p class="eyebrow"><span class="plate">04</span> Who it’s for</p>
        <h2 id="fit-title" class="display-2">For any environment that isn’t production.</h2>
        <p class="lede fit__lede">For platform and infrastructure engineers who run staging, preview and dev environments on their own Kubernetes clusters.</p>
      </div>
      <div class="fit__list">
        <h3 class="h3">What it won’t do</h3>
        <ul>
          <li><b>Delete anything.</b> Its one action is to pause, which scales a workload to zero. A StatefulSet whose PVCs would be deleted on scale-down is never paused.</li>
          <li><b>Guess who’s a person.</b> Napwake can’t tell. On an environment anyone can reach, set it to ask. Then requests wake nothing, and a browser gets a Wake it button.</li>
          <li><b>Run to a timetable.</b> It pauses on idleness, not at 8pm. A workload idle all afternoon is paused, and a request at midnight wakes it.</li>
          <li><b>Replace your autoscaler.</b> While a workload runs, its HPA or KEDA decides how many replicas it needs. Napwake only decides whether it should run at all.</li>
        </ul>
        <p><a href="/compare/">How it compares</a></p>
      </div>
    </div>
  </section>

  <section class="section start" aria-labelledby="start-title">
    <div class="wrap start__in">
      <div class="start__art"><Pose name="point" alt="The doorman points the way." width={220} /></div>
      <div class="start__body">
        <p class="eyebrow"><span class="plate">05</span> Start</p>
        <h2 id="start-title" class="display-2">Scan, then try one workload.</h2>
        <p class="muted">The Quickstart takes one workload from idle and costing money to paused while idle, measuring it in dry-run first so nothing pauses until you say so.</p>
        <Terminal class="start__term" command={['brew install napwake/tap/kubectl-napwake', 'kubectl napwake scan']} label="Install the kubectl plugin and scan a cluster" />
        <div class="actions">
          <Button to={links.install} variant="primary">Install</Button>
          <Button to={links.quickstart}>Quickstart</Button>
        </div>
        <p class="licence small muted">Free and open source under <a href={links.apache.href}>Apache 2.0</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: var(--space-18) 0 var(--space-12); }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); column-gap: var(--space-12); align-items: end; }
  .hero__in > .eyebrow { grid-column: 1 / -1; }
  .hero__h1 { max-width: 12.5em; }
  .hero__side { padding-bottom: 6px; }
  .hero__side .lede { margin-bottom: var(--space-4); }
  .licence { margin: var(--space-3) 0 0; }
  .licence a { color: inherit; }
  .hero__never { display: flex; align-items: center; gap: var(--space-2); font-weight: 700; margin-bottom: var(--space-6); }

  .scan__notes { list-style: none; counter-reset: n; margin: var(--space-12) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
  .scan__notes li { counter-increment: n; position: relative; padding-top: var(--space-8); font-size: 15px; line-height: 1.5; color: var(--muted); }
  .scan__notes li b { color: var(--text); }
  .scan__notes li::before { content: counter(n); position: absolute; top: 0; left: 0; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: var(--bg); font: 700 12px/1 var(--font-mono); }
  .scan__send { margin: var(--space-8) 0 0; padding-top: var(--space-6); border-top: 1px solid var(--line); color: var(--muted); }
  .scan__send b { color: var(--text); }
  .scan__send a { font-weight: 700; margin-left: var(--space-2); white-space: nowrap; }

  .states { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .state { display: grid; gap: var(--space-3); align-content: start; padding: 0 var(--space-6) var(--space-6); overflow: hidden; }
  .state :global(.state__art) { width: calc(100% + 2 * var(--space-6)); max-width: none; height: auto; background: var(--scene-wall); margin: 0 calc(-1 * var(--space-6)) var(--space-3); }
  .state p { margin: 0; color: var(--text); font-size: 16px; }

  /* two doors side by side; subgrid lines up their heads, pictures and steps */
  .doors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto auto auto; column-gap: var(--space-12); row-gap: var(--space-6); }
  .door { display: grid; grid-row: span 3; grid-template-rows: subgrid; min-width: 0; }
  .door__head { border-top: 2px solid var(--line); padding-top: var(--space-4); }
  .door__head .h3 { margin-bottom: var(--space-1); }
  .door__what { margin: 0; color: var(--muted); }
  .door__mock { align-self: start; min-width: 0; }
  .door__steps { list-style: none; margin: var(--space-2) 0 0; padding: 0; }
  .door__steps li { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--space-4); align-items: baseline; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .door__steps li:first-child { border-top: 0; }
  .door__steps .nw-badge { align-self: start; padding-top: 2px; }
  .door__steps p { margin: 0; font-size: 16px; line-height: 1.5; }

  /* everyone else, per door */
  .others { margin-top: var(--space-12); }
  .others table { table-layout: fixed; font-size: 15px; }
  .others thead th:first-child { width: 30%; }
  .others tbody th { white-space: normal; font-weight: 700; }
  .others td { color: var(--text); }
  .others__out { display: flex; gap: var(--space-2); align-items: flex-start; }
  .others__out :global(.nw-door) { margin-top: 2px; }
  .others__both { background: var(--bg); }
  .wake__foot { margin: var(--space-4) 0 0; max-width: 60em; }

  .fit { align-items: start; }
  .fit__lede { margin-top: var(--space-4); }
  .fit__list ul { list-style: none; padding: 0; margin: var(--space-4) 0 var(--space-6); display: grid; gap: var(--space-4); }
  .fit__list li { padding-left: var(--space-6); position: relative; color: var(--muted); }
  .fit__list li b { color: var(--text); }
  .fit__list li::before { content: ""; position: absolute; left: 0; top: .55em; width: 10px; height: 12px; border-radius: 5px 5px 0 0; background: var(--glyph-slate); }

  .start { background: var(--surface); }
  .start__in { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: var(--space-12); align-items: center; }
  .start__art { display: grid; place-items: center; }
  .start__body h2 { margin-bottom: var(--space-4); }
  .start__body :global(.start__term) { margin: var(--space-6) 0; max-width: 40em; }

  @media (max-width: 1000px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); }
    .hero__side { margin-top: var(--space-6); }
    .states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .doors { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; row-gap: var(--space-12); }
    .door { grid-row: auto; grid-template-rows: none; row-gap: var(--space-6); }
  }
  @media (max-width: 760px) {
    .states { grid-template-columns: minmax(0, 1fr); }
    .start__in { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .start__art { justify-content: start; }
    .start__art :global(svg) { width: 150px; }
  }
  @media (max-width: 600px) {
    .hero { padding: var(--space-12) 0 var(--space-8); }
    .scan__notes { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .scan__notes li { padding: 0 0 0 var(--space-8); }
    /* the install line wraps after `install` rather than scroll sideways */
    .start__body :global(.start__term .nw-term) { white-space: pre-wrap; font-size: 13px; }
    .door__steps li { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
    .others { background: none; border: 0; overflow: visible; }
    .others table, .others tbody, .others tr, .others th, .others td { display: block; }
    .others thead { display: none; }
    .others tr { border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-2); }
    .others th, .others td { padding: 2px 0; border: 0; }
    .others td[data-label]::before { content: attr(data-label); display: block; font: 700 11px/1.6 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--muted); margin-top: var(--space-2); }
    .others__both { background: none; }
    .others__both[data-label]::before { display: none; }
  }
</style>
